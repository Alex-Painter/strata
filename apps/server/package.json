{
  "name": "@strata/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hono API: GitHub sign-in, analysis jobs, chat, and the built web app.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@strata/core": "workspace:*",
    "arctic": "^3.7.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2"
  }
}
