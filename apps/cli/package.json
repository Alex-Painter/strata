{
  "name": "@strata/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Run a Strata analysis from the terminal and write a self-contained review page.",
  "bin": {
    "strata": "./src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@strata/core": "workspace:*",
    "@strata/engine": "workspace:*"
  }
}
