# Copy to .env at the repo root for `pnpm dev`. Never commit .env.

# --- Quick start: skip GitHub sign-in locally ------------------------------
# Synthesises a session for DEV_GITHUB_LOGIN. Ignored when NODE_ENV=production.
DEV_AUTH_BYPASS=1
DEV_GITHUB_LOGIN=your-github-login
# A token for GitHub reads, e.g. `DEV_GITHUB_TOKEN="$(gh auth token)" pnpm dev`.
# Better passed like that than written here.
# DEV_GITHUB_TOKEN=

# --- Real GitHub sign-in ----------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers with callback
# URL <PUBLIC_URL>/auth/callback (locally http://localhost:5173/auth/callback).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Comma-separated logins allowed to sign in. Required unless the bypass is on.
# ALLOWED_GITHUB_LOGINS=your-github-login
# At least 32 random characters: `openssl rand -base64 48`. Required in production.
# SESSION_SECRET=

# --- Server -----------------------------------------------------------------
# Where people open Strata. Locally that's the Vite dev server, which proxies
# /api and /auth to the API server.
# PUBLIC_URL=http://localhost:5173
# PORT=8787
# SQLite database, the PR index and the git clone cache. Defaults to .data in the
# server's working directory locally (apps/server/.data under `pnpm dev`)
# and to /data in the Docker image.
# DATA_DIR=

# Local checkouts Strata may borrow git objects from (it never writes to them):
# owner/name=path, comma-separated. ~ is expanded.
# STRATA_CHECKOUTS=GlyphicAI/maverick-backend=~/workspace/maverick-backend

# --- LLM (optional) ---------------------------------------------------------
# Without a key, analysis runs its deterministic steps only.
# ANTHROPIC_API_KEY=
# STRATA_MODEL=claude-opus-5-5
